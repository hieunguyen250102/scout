# Copy to server/.env for local runs; on Render set these in the dashboard.
# On Render's free plan SMTP is blocked — use BREVO_API_KEY there instead.
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="SCOUT <you@gmail.com>"
HOST_EMAILS=you@gmail.com
SESSION_SECRET=
